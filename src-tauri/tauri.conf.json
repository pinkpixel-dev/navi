{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Navi",
  "version": "1.0.1",
  "identifier": "dev.pinkpixel.navi",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Navi",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "publisher": "Pink Pixel",
    "copyright": "Copyright © 2026 Pink Pixel",
    "shortDescription": "Local-first MCP chat app for local and hosted models.",
    "longDescription": "Navi is a local-first chat app that connects local GGUF models, Ollama, LM Studio, and hosted providers (OpenAI, Anthropic, Gemini, OpenRouter) with MCP tool servers, an artifact canvas, and project-organized conversations.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "section": "utils",
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
